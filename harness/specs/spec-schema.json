{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "revery-prairie-spec",
  "title": "Feature Spec",
  "description": "Schema for revery-prairie feature specification files",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "priority",
    "layer",
    "source_files",
    "behaviors",
    "edge_cases",
    "failure_conditions",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Unique kebab-case identifier"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["implemented", "partial", "planned"]
    },
    "priority": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    },
    "layer": {
      "type": "string",
      "enum": ["engine", "component", "integration"]
    },
    "source_files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "inputs",
          "outputs",
          "state_changes",
          "determinism"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "state_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "effect"],
              "additionalProperties": false,
              "properties": {
                "field": { "type": "string", "minLength": 1 },
                "effect": { "type": "string", "minLength": 1 }
              }
            }
          },
          "determinism": {
            "type": "string",
            "enum": ["deterministic", "probabilistic", "time-based"]
          }
        }
      }
    },
    "edge_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 10
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["trigger", "expected"],
        "additionalProperties": false,
        "properties": {
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["test_file", "test_pattern", "command"],
      "additionalProperties": false,
      "properties": {
        "test_file": {
          "type": "string",
          "minLength": 1
        },
        "test_pattern": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
