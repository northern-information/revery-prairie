{
  "name": "revery-prairie",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "shared",
    "worker"
  ],
  "scripts": {
    "backlog": "tsx --tsconfig tools/backlog-tui/tsconfig.json tools/backlog-tui/index.tsx",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && npm --workspace @revery-prairie/worker run deploy",
    "dev": "vite",
    "fetch-font": "node tools/fetch-voynich-font.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "harness:check": "tsx harness/src/harness-check.ts",
    "harness:run": "tsx harness/src/plan-cli.ts run",
    "harness:status": "tsx harness/src/plan-cli.ts status",
    "lint": "eslint .",
    "preview": "vite preview",
    "spec:validate": "tsx harness/src/validate-cli.ts harness/specs",
    "sync:audio": "node tools/sync-audio.mjs",
    "test:components": "vitest run src/components/",
    "test:engine": "vitest run src/engine/",
    "test:harness": "vitest run src/harness/ harness/",
    "test:watch": "vitest",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "ink": "8.0.0",
    "jsdom": "31.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
