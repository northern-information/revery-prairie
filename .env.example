# Origin of the worker that hosts the multiplayer API.
#
# Production builds bundle the SPA into the same worker that serves /api/*,
# so multiplayer "just works" at the deployed URL with no env var set.
#
# This var is only needed when running `npm run dev` (Vite dev server on
# :5173) and you want online mode to talk to a remotely deployed worker.
# Set it to the worker origin without a trailing slash.
#
# Examples:
#   Local wrangler dev:   http://localhost:8787
#   Remote workers.dev:   https://revery-prairie-worker.<your-subdomain>.workers.dev
VITE_WORKER_URL=
